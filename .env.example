# Local dev (docker-compose). Production uses Neon connection string.
DATABASE_URL=postgres://cai:cai_dev@localhost:5433/cai_career

# Agent runner backend: "claude-code" (Mac, subscription, default) | "api" (credits, $20 hard cap)
AGENT_RUNNER=claude-code

# Only needed when AGENT_RUNNER=api or for the Vercel coach fallback
ANTHROPIC_API_KEY=

# Gmail OAuth (Stage 3) — dedicated account for Cai
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Telegram coach/notification bot (Stage 4)
TELEGRAM_BOT_TOKEN=
