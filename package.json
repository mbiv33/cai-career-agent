{
  "name": "cai-career-agent",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @cai/db generate",
    "db:migrate": "pnpm --filter @cai/db migrate",
    "db:seed": "pnpm --filter @cai/db seed"
  },
  "devDependencies": {
    "turbo": "^2.11.3",
    "typescript": "^7.0.2"
  }
}
